# Yerel Docker Compose ayarları. Kopyala:  cp .env.example .env
# (.env git'e girmez.)

# Hangi compose dosyaları birleştirilsin? Böylece sadece `docker compose up`
# yazmak yeter. Ayırıcı Linux/WSL'de ':' (Windows PowerShell'de ';').
#
#   Yalnızca CPU (teslim):          COMPOSE_FILE=docker-compose.yml
#   GPU:                             COMPOSE_FILE=docker-compose.yml:docker-compose.gpu.yml
#   GPU + geliştirme (önerilen dev): aşağıdaki satır
COMPOSE_FILE=docker-compose.yml:docker-compose.gpu.yml:docker-compose.dev.yml

# Geliştirme modunda container'ın çalışacağı kullanıcı (host kullanıcınla aynı
# olmalı; `id -u` / `id -g`). WSL2 Ubuntu'da genelde 1000.
UID=1000
GID=1000
